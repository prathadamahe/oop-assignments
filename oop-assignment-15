#include <iostream>
#include <fstream>
using namespace std;

int main() {

    // Write mode
    ofstream file;

    file.open("data.txt", ios::out);

    file << "First line" << endl;
    file << "Second line" << endl;

    file.close();

    // Append mode
    file.open("data.txt", ios::app);

    file << "Third line added later" << endl;

    file.close();

    // Read mode
    ifstream readFile;

    readFile.open("data.txt", ios::in);

    string line;

    cout << "File Contents:" << endl;

    while (getline(readFile, line)) {
        cout << line << endl;
    }

    readFile.close();

    return 0;
}
