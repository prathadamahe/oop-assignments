#include <iostream>
using namespace std;

class Book {
private:
    string title;
    string author;
    float price;

public:
    // Default constructor
    Book() {
        title = "Unknown";
        author = "Unknown";
        price = 0;
    }

    // Parameterized constructor
    Book(string t, string a, float p) {
        title = t;
        author = a;
        price = p;
    }

    void display() {
        cout << "Title  : " << title << endl;
        cout << "Author : " << author << endl;
        cout << "Price  : " << price << endl;
    }
};

int main() {
    Book b1;
    Book b2("C++ Programming", "Bjarne Stroustrup", 600);

    cout << "Book 1:" << endl;
    b1.display();

    cout << "\nBook 2:" << endl;
    b2.display();

    return 0;
}
