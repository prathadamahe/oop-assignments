#include <iostream>
#include <fstream>
using namespace std;

class Employee {
private:
    int id;
    string name;
    float salary;

public:
    void input() {
        cout << "Enter Employee ID: ";
        cin >> id;

        cout << "Enter Name: ";
        cin >> name;

        cout << "Enter Salary: ";
        cin >> salary;
    }

    void saveToFile() {
        ofstream file("employee.txt");

        file << id << endl;
        file << name << endl;
        file << salary << endl;

        file.close();
    }

    void displayFromFile() {
        ifstream file("employee.txt");

        file >> id;
        file >> name;
        file >> salary;

        file.close();

        cout << "\nEmployee Details:" << endl;
        cout << "ID     : " << id << endl;
        cout << "Name   : " << name << endl;
        cout << "Salary : " << salary << endl;
    }
};

int main() {
    Employee e;

    e.input();
    e.saveToFile();

    Employee e2;
    e2.displayFromFile();

    return 0;
}
