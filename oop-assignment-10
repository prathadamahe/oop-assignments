#include <iostream>
using namespace std;

template <class T>
T larger(T a, T b) {
    if (a > b)
        return a;
    else
        return b;
}

int main() {
    cout << "Larger integer: "
         << larger(10, 20) << endl;

    cout << "Larger double: "
         << larger(15.5, 12.8) << endl;

    cout << "Larger character: "
         << larger('A', 'Z') << endl;

    return 0;
}
