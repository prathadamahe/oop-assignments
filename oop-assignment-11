#include <iostream>
using namespace std;

template <class T>
void swapValues(T &a, T &b) {
    T temp = a;
    a = b;
    b = temp;
}

int main() {
    int a = 10, b = 20;

    cout << "Before swap: " << a << " " << b << endl;

    swapValues(a, b);

    cout << "After swap: " << a << " " << b << endl;

    double x = 2.5, y = 5.5;

    cout << "\nBefore swap: " << x << " " << y << endl;

    swapValues(x, y);

    cout << "After swap: " << x << " " << y << endl;

    return 0;
}
